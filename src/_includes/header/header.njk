<header class="absolute top-[80px] left-[0px] z-10 flex w-full items-center gap-[24px] bg-transparent px-[100px]">
    <a href="/" aria-label="{{ site.title }} home" class="shrink-0">
        <img src="{{ site.logo }}" alt="{{ site.title }}" width="200" height="58">
    </a>

    <nav class="ml-auto">
        <ul class="flex items-center gap-[60px]">
            {%- for item in navigation %}
            {%- set isCurrent = false %}
            {%- if item.url == '/' %}
            {%- if page.url == '/' %}
            {%- set isCurrent = true %}
            {%- endif %}
            {%- else %}
            {%- if page.url.startsWith(item.url) %}
            {%- set isCurrent = true %}
            {%- endif %}
            {%- endif %}
            <li>
                <a href="{{ item.url }}" class="text-white
                    {%- if isCurrent %} underline underline-offset-[5px]{% endif %}" {%- if isCurrent %} aria-current="page" {% endif %}>
                    {{ item.label }}
                </a>
            </li>
            {%- endfor %}
            <li>
                <ul class="flex items-center gap-[20px]">
                    {%- for key, url in site.social %}
                    {%- if url %}
                    <li>
                        <a href="{{ url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ key | capitalize }}">
                            <img src="/assets/svgs/{{ key }}.svg" alt="" width="24" height="24">
                        </a>
                    </li>
                    {%- endif %}
                    {%- endfor %}
                </ul>
            </li>
        </ul>
    </nav>
</header>
